{
  "name": "@storify/database",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:generate": "prisma generate && prisma generate --schema=prisma/schema.tenant.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seeds/master.seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.10.2",
    "typescript": "^5.4.2",
    "tsx": "^4.7.1",
    "@types/node": "^20.11.24"
  }
}
