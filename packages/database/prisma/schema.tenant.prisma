// Tenant DB schema — Step 04 (auth models: Branch, Role, User, PasswordResetToken)
// Step 05 will expand this to all 34 tenant tables.
//
// Important: datasource URL is a placeholder. At runtime, getTenantDb() overrides
// it with: postgresql://...?schema=tenant_<subdomain>

generator tenantClient {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_MASTER_URL")
}

// ─── Tenant Models (Step 04 — Auth) ─────────────────────────────────────────

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true)  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  users User[]

  @@map("branches")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.Text     @map("password_hash")
  fullName     String    @db.VarChar(200) @map("full_name")
  phone        String?   @db.VarChar(50)
  roleId       String    @db.Uuid    @map("role_id")
  branchId     String?   @db.Uuid    @map("branch_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  role               Role                 @relation(fields: [roleId], references: [id])
  branch             Branch?              @relation(fields: [branchId], references: [id])
  passwordResetTokens PasswordResetToken[]

  @@index([email], name: "idx_users_email")
  @@index([roleId], name: "idx_users_role")
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  tokenHash String    @unique @db.Text @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_reset_user")
  @@map("password_reset_tokens")
}
